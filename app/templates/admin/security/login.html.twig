{% extends 'admin/base.html.twig' %}

{% block stylesheet %}
    {{ parent() }}
    <style>
        .btn-primary {
            --bs-btn-color: #fff;
            --bs-btn-bg: #11114c;
            --bs-btn-border-color: #11114c;
            --bs-btn-hover-color: #fff;
            --bs-btn-hover-bg: #11114c;
            --bs-btn-hover-border-color: #11114c;
            --bs-btn-focus-shadow-rgb: 111, 132, 234;
            --bs-btn-active-color: #fff;
            --bs-btn-active-bg: #11114c;
            --bs-btn-active-border-color: #11114c;
            --bs-btn-active-shadow: inset 0 3px 5px rgba(0, 0, 0, 0.125);
            --bs-btn-disabled-color: #fff;
            --bs-btn-disabled-bg: #3535a0;
            --bs-btn-disabled-border-color: #3535a0;
        }
    </style>
{% endblock %}


{% block body %}

    <div class="account-pages my-5 pt-sm-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6 col-xl-5">
                    <div class="card overflow-hidden">
                        <div class="bg-white bg-soft">
                            <div class="d-flex justify-content-center align-content-center">
                                <div>
                                    <img width="200" src="{{ asset('assets/admin/images/logo_sfp.png') }}" alt="" class="img-fluid">
                                </div>
                            </div>
                        </div>
                        <div class="card-body pt-0">
                            <div class="p-1">
                                <form class="form-horizontal" method="post">

                                    {% if error %}
                                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                                    {% endif %}
                                    <div class="mb-3">
                                        <label for="username" class="form-label">Utilisateur</label>
                                        <input type="text" name="username" class="form-control" id="username" placeholder="Enter username">
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Mot de passe</label>
                                        <div class="input-group auth-pass-inputgroup">
                                            <input type="password" name="password" class="form-control" placeholder="Enter password" aria-label="Password" aria-describedby="password-addon">
                                            <button class="btn btn-light " type="button" id="password-addon"><i class="mdi mdi-eye-outline"></i></button>
                                        </div>
                                    </div>

                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="reartisan-check">
                                        <label class="form-check-label" for="reartisan-check">
                                            Se souvenir de moi
                                        </label>
                                    </div>

                                    <div class="mt-3 d-grid">
                                        <button class="btn btn-primary waves-effect waves-light" type="submit">Connexion</button>
                                    </div>

                                    <div class="mt-4 text-center">
                                    </div>

                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                                </form>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascript %}
    {{ parent() }}
<script type="text/javascript">
   jQuery(document).ready(function ($) {
    });
</script>
{% endblock %}
