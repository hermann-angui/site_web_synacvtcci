{% extends 'admin/base.html.twig' %}

{% block stylesheet %}
    {{ parent() }}
    <link href="{{ asset('assets/admin/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css') }}" rel="stylesheet" type="text/css" />
    <link href="{{ asset('assets/admin/libs/datatables.net-bs4/css/select.dataTables.min.css') }}" rel="stylesheet" type="text/css" />
    <style>
        .card-body{
            border: 1px solid #0701b9;
        }
        table thead.datable-thead {
            background-color: #313131;
            color: #fff;
        }
    </style>
{% endblock %}

{% block body %}
    <!-- Begin page -->
    <div id="layout-wrapper">

        {% if is_granted('ROLE_ADMIN') %}
            {{ include('admin/_partials/header.html.twig') }}

            <!-- ========== Left Sidebar Start ========== -->
            {{ include('admin/_partials/left-sidebar.html.twig')}}
            <!-- Left Sidebar End -->
        {% endif %}

        {% if is_granted('ROLE_AGENT') %}
            {{ include('admin/_partials/simple-header.html.twig') }}
        {% endif %}
        <div class="main-content">
            <div class="page-content">
                <div class="container-fluid">
                    <div class="row mb-4">
                        <div class="d-flex align-items-center p-3">
                            <h5 class="mb-0 card-title flex-grow-1">PARAMETRES</h5>
                            <div class="flex-shrink-0">
                                <a href="{{  path('admin_configuration_new') }}" class="btn btn-primary btn-sm waves-effect waves-light"><span class="fa fa-plus-circle fa-1x"></span> Créer un nouveau paramètre</a>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="card">
                                <div class="card-body">
                                    <div class="col-sm-12">
                                        <table id="datatable" class="table table-responsive no-footer" style="width:100%">
                                            <thead class="datable-thead">
                                            <tr>
                                                <th>ID</th>
                                                <th>NOM DU PARAMETRE</th>
                                                <th>VALEUR</th>
                                                <th>TYPE</th>
                                                <th>DESCRIPTION</th>
                                                <th>Actions</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascript %}
{{ parent() }}
<script src="{{ asset('assets/admin/libs/datatables.net/js/jquery.dataTables.min.js') }}"></script>
<script src="{{ asset('assets/admin/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js') }}"></script>
<script type="text/javascript">
    jQuery(document).ready(function ($) {
      var datatable = initDatatable();
      function initDatatable(){
            /* DATATABLE INIT */
            var dt = $('#datatable').DataTable( {
                "responsive": true,
                "pageLength": 50,
                "language": {
                    url: '//cdn.datatables.net/plug-ins/1.10.16/i18n/French.json',
                    processing: "<img height='32' width='32' src='{{ asset("assets/images/preloaders/5.svg") }}' />",
                    sLoadingRecords :"<img height='32' width='32' src='{{ asset("assets/images/preloaders/5.svg") }} />"
                },
                "processing": true,
                "serverSide": true,
                "ajax": {
                    "url": '{{ path('admin_configuration_dt') }}',
                    "data": function (d) {

                    }
                },
                "columns": [
                    {"data":  "id"},
                    {"data":  "name"},
                    {"data":  "value"},
                    {"data":  "type"},
                    {"data":  "description"},
                    { "data": "" }
                ],
                "order": [[1, 'desc']]
            } );


            return dt;
        }
    });
</script>
{% endblock %}
