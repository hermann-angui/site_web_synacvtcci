<!DOCTYPE html>

<title>Configuration</title>

{% block body %}
    <h1>Configuration</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ configuration.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ configuration.name }}</td>
            </tr>
            <tr>
                <th>Value</th>
                <td>{{ configuration.value }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ configuration.type }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ configuration.description }}</td>
            </tr>
            <tr>
                <th>Created_at</th>
                <td>{{ configuration.createdAt ? configuration.createdAt|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Modified_at</th>
                <td>{{ configuration.modifiedAt ? configuration.modifiedAt|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_configuration_index') }}">back to list</a>

    <a href="{{ path('app_configuration_edit', {'id': configuration.id}) }}">edit</a>

    {{ include('configuration/_delete_form.html.twig') }}
{% endblock %}
