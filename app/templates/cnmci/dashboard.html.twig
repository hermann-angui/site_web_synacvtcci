{% extends 'admin/base.html.twig' %}

{% block stylesheet %}
    {{ parent() }}
    <link href="{{ asset('assets/admin/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css') }}" rel="stylesheet" type="text/css" />
    <link href="{{ asset('assets/admin/libs/datatables.net-bs4/css/select.dataTables.min.css') }}" rel="stylesheet" type="text/css" />
    <style>
        .btn-cnmci {
            background-color: #6e0000;
            color: #ffffff;
        }
        .btn:hover {
            color: #fff;
            text-decoration: none;
            background-color: #343a40;
            border-color: var(--bs-btn-hover-border-color);
        }
        .vertical-collpsed .main-content {
            margin-left: 10px !important;
        }
        .page-content {
            padding: 10px 0 0 0;
        }

        .avatar-title {
            -webkit-box-align: center;
            -ms-flex-align: center;
            align-items: center;
            background-color: #c23531;
            color: #fff;
            display: -webkit-box;
            display: -ms-flexbox;
            display: flex;
            font-weight: 500;
            height: 100%;
            -webkit-box-pack: center;
            -ms-flex-pack: center;
            justify-content: center;
            width: 100%;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="layout-wrapper">
        <div class="main-content">
            <div class="page-content">
                <div class="container-fluid">
                    <div class="d-flex justify-content-center">
                        <img src="{{ asset('assets/frontend/img/cnmci.png') }}" alt="logo syncvtcci" width="150" alt="logo cnmci" style="border-collapse: collapse;border-width:0px 0px;" />
                    </div>
                    <div class="d-flex justify-content-between py-4">
                        <div class="col-lg-9"><a href="{{ path('cnmci_index')}}" class="btn btn-link waves-effect waves-light"><i class="fa fa-arrow-left"></i> Revenir à l'accueil</a></div>
                        <div class="col-lg-3 justify-content-end ">
                            <div class="d-flex align-items-center">
                                {% if app.user.photo %}
                                    <img src="{{ asset('users/') ~ app.user.photo }}" alt="" class="avatar-sm rounded">
                                {% else %}
                                    <img src="{{ asset('/assets/images/avatar/avatar.jpg') }}" alt="" class="avatar-sm rounded">
                                {% endif %}
                                <div class="ms-3 flex-grow-1">
                                    <h5 class="mb-2 card-title">Bienvenue, {{ app.user.lastName|upper ~ ' ' ~ app.user.firstName}}</h5>
                                </div>
                            </div>
                        </div><!--end col-->
                    </div>
                    <div class="row mb-3" >
                        <div class="col-12">
                            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                                <h4 class="mb-sm-0 font-size-18">Statistiques</h4>
                                <div class="page-title-right">
                                    <ol class="breadcrumb m-0">
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div><!-- end row -->
                    <div class="row">
                        <div class="col-lg-3">
                            <div class="card mini-stats-wid">
                                <div class="card-body">
                                    <div class="d-flex">
                                        <div class="flex-grow-1">
                                            <p class="text-muted fw-bolder">TOTAL CHAUFFEURS INSCRITS</p>
                                            <h4 class="mb-0 fw-bolder">{{ totals.total_souscriptions }}</h4>
                                        </div>
                                        <div class="flex-shrink-0 align-self-center">
                                            <div class="mini-stat-icon avatar-sm rounded-circle bg-warning">
                                                <span class="avatar-title">
                                                    <i class="fa fa-user-friends font-size-24"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div><!--end col-->
                        <div class="col-lg-3">
                            <div class="card mini-stats-wid">
                                <div class="card-body">
                                    <div class="d-flex">
                                        <div class="flex-grow-1">
                                            <p class="text-muted fw-medium">TOTAL CHAUFFEURS VTC</p>
                                            <h4 class="mb-0">{{ totals.total_vtc }}</h4>
                                        </div>
                                        <div class="flex-shrink-0 align-self-center">
                                            <div class="mini-stat-icon avatar-sm rounded-circle bg-primary">
                                                <span class="avatar-title">
                                                    <i class="fa fa-car font-size-24"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div><!--end col-->
                        <div class="col-lg-3">
                            <div class="card mini-stats-wid">
                                <div class="card-body">
                                    <div class="d-flex">
                                        <div class="flex-grow-1">
                                            <p class="text-muted fw-medium">TOTAL CHAUFFEURS TAXI</p>
                                            <h4 class="mb-0">{{ totals.total_taxi }}</h4>
                                        </div>
                                        <div class="flex-shrink-0 align-self-center">
                                            <div class="mini-stat-icon avatar-sm rounded-circle bg-success">
                                                <span class="avatar-title">
                                                    <i class="fa fa-car-side font-size-24"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div><!--end col-->
                        <div class="col-lg-3">
                            <div class="card mini-stats-wid">
                                <div class="card-body">
                                    <div class="d-flex">
                                        <div class="flex-grow-1">
                                            <p class="text-muted fw-medium">TOTAL CHAUFFEURS LIVREURS</p>
                                            <h4 class="mb-0">{{ totals.total_livreurs }}</h4>
                                        </div>
                                        <div class="flex-shrink-0 align-self-center">
                                            <div class="mini-stat-icon avatar-sm rounded-circle bg-info">
                                                <span class="avatar-title">
                                                    <i class="fa fa-biking font-size-24"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div><!--end col-->
                    </div><!--end row-->
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="card">
                                <div class="card-body">
                                    <h4 class="card-title mb-4">Statistique par commune</h4>
                                    <div id="commune-chart" data-colors='' class="e-charts"></div>
                                </div>
                            </div>
                        </div><!--end col-->
                        <div class="col-lg-6">
                            <div class="card">
                                <div class="card-body">
                                    <h4 class="card-title mb-4">Statistiques des souscriptions</h4>
                                    <div data-colors='["--bs-primary", "--bs-success", "--bs-warning", "--bs-info"]' class="e-charts" id="souscription-chart"></div>
                                </div>
                            </div>
                        </div><!--end col-->
                    </div>
                    <div class="row">
                        <div class="col-xl-3">
                            <div class="card">
                                <div class="card-body">
                                    <h4 class="card-title mb-4">Classement par genre</h4>
                                    <div id="sex-chart" data-colors='["--bs-primary","--bs-warning", "--bs-danger","--bs-info", "--bs-success"]' class="e-charts"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-3">
                            <div class="card">
                                <div class="card-body">
                                    <h4 class="card-title mb-4">Classement par nationalité</h4>
                                    <div id="nationality-chart" data-colors='["--bs-primary","--bs-warning", "--bs-danger","--bs-info", "--bs-success"]' class="e-charts"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-3">
                            <div class="card">
                                <div class="card-body">
                                    <h4 class="card-title mb-4">Classement par activité</h4>
                                    <div id="activity-chart" data-colors='["--bs-primary","--bs-warning", "--bs-danger","--bs-info", "--bs-success"]' class="e-charts"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="card">
                                <div class="card-body">
                                    <h4 class="card-title mb-3">A l'instant</h4>
                                    <div id="carouselExampleControls" class="carousel slide" data-bs-ride="carousel">
                                        <div class="carousel-inner">

                                            <div class="carousel-item active" data-bs-interval="3000">
                                                {% for i, member in latest|slice(0, 4) %}
                                                    <div class="bg-light p-3 d-flex mb-3 rounded">
                                                        <img src="/members/{{ member.reference }}/{{ member.photo }}" alt="" class="avatar-sm rounded me-3">
                                                        <div class="flex-grow-1">
                                                            <h5 class="font-size-15 mb-2"><a href="{{  path('admin_member_cncmi_show', {id: member.id}) }}" class="text-body">{{ member.lastName|upper ~ ' ' ~ member.firstName|upper }}</a> <span class="badge badge-soft-info">{{ member.activity }}</span></h5>
                                                        </div>
                                                        <div>
                                                            <div class="dropdown">
                                                                <button class="btn btn-soft-primary" type="button" id="dropdownMenuButton11" data-bs-toggle="dropdown" aria-expanded="false">
                                                                    <i class='bx bx-dots-vertical-rounded'></i>
                                                                </button>
                                                                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton11">
                                                                    <li><a class="dropdown-item" href="{{  path('admin_member_cncmi_show', {id: member.id}) }}">Voir detail</a></li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                            <div class="carousel-item" data-bs-interval="3000">
                                                {% for i, member in latest|slice(4, 4) %}
                                                    <div class="bg-light p-3 d-flex mb-3 rounded">
                                                        <img src="/members/{{ member.reference }}/{{ member.photo }}" alt="" class="avatar-sm rounded me-3">
                                                        <div class="flex-grow-1">
                                                            <h5 class="font-size-15 mb-2"><a href="{{  path('admin_member_cncmi_show', {id: member.id}) }}" class="text-body">{{ member.lastName|upper ~ ' ' ~ member.firstName|upper }}</a> <span class="badge badge-soft-info">{{ member.activity }}</span></h5>
                                                        </div>
                                                        <div>
                                                            <div class="dropdown">
                                                                <button class="btn btn-soft-primary" type="button" id="dropdownMenuButton11" data-bs-toggle="dropdown" aria-expanded="false">
                                                                    <i class='bx bx-dots-vertical-rounded'></i>
                                                                </button>
                                                                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton11">
                                                                    <li><a class="dropdown-item" href="{{  path('admin_member_cncmi_show', {id: member.id}) }}">Voir detail</a></li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                            <div class="carousel-item" data-bs-interval="3000">
                                                {% for i, member in latest|slice(8, 4) %}
                                                    <div class="bg-light p-3 d-flex mb-3 rounded">
                                                        <img src="/members/{{ member.reference }}/{{ member.photo }}" alt="" class="avatar-sm rounded me-3">
                                                        <div class="flex-grow-1">
                                                            <h5 class="font-size-15 mb-2"><a href="{{  path('admin_member_cncmi_show', {id: member.id}) }}" class="text-body">{{ member.lastName|upper ~ ' ' ~ member.firstName|upper }}</a> <span class="badge badge-soft-info">{{ member.activity }}</span></h5>
                                                        </div>
                                                        <div>
                                                            <div class="dropdown">
                                                                <button class="btn btn-soft-primary" type="button" id="dropdownMenuButton11" data-bs-toggle="dropdown" aria-expanded="false">
                                                                    <i class='bx bx-dots-vertical-rounded'></i>
                                                                </button>
                                                                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton11">
                                                                    <li><a class="dropdown-item" href="{{  path('admin_member_cncmi_show', {id: member.id}) }}">Voir detail</a></li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div><!--end card-->
                        </div><!--end col-->
                    </div><!--end row-->
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="card">
                                <div class="card-body">
                                    <div class="d-flex">
                                        <h4 class="card-title">Tableaux des souscripteurs à la CNMCI</h4>
                                        <div class="dropdown ms-auto">
                                            <a class="text-muted font-size-16" role="button" data-bs-toggle="dropdown" aria-haspopup="true">
                                                <i class="mdi mdi-dots-horizontal"></i>
                                            </a>

                                            <div class="dropdown-menu dropdown-menu-end">
                                                <a class="dropdown-item" href="#">Rafraichir</a>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="table-responsive">
                                        {{ include('cnmci/_adherents_datatable.html.twig') }}
                                    </div>
                                </div>
                            </div><!--end card-->
                        </div><!--end col-->
                        <div class="col-lg-4">
                            <div class="card">
                                <div class="card-body">
                                    <h4 class="card-title mb-4">Activités récentes</h4>
                                    <div data-simplebar style="max-height: 600px;">
                                        <ul class="verti-timeline list-unstyled">
                                            {% for i, member in latest|slice(0, 10) %}
                                                <li class="event-list">
                                                    <div class="event-timeline-dot">
                                                        <i class="bx bx-right-arrow-circle font-size-18"></i>
                                                    </div>
                                                    <div class="d-flex">
                                                        <div class="flex-shrink-0 me-3">
                                                            <img src="/members/{{ member.reference }}/{{ member.photo }}" alt="" class="avatar-xs rounded-circle">
                                                        </div>
                                                        <div class="flex-grow-1">
                                                            <div>
                                                                <b>{{ member.firstName|upper ~ ' ' ~ member.lastName|upper }}</b> vient de faire son inscription <b>{{ member.activity }}</b>
                                                                <p class="mb-0 text-muted">Il y' a 3 min</p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                        <div class="text-center mt-4"><a href="javascript: void(0);" class="btn btn-primary waves-effect waves-light btn-sm">View More <i class="mdi mdi-arrow-right ms-1"></i></a></div>
                                    </div>
                                </div>
                            </div><!--end card-->
                        </div><!--end col-->
                    </div><!--end row-->
                    <!-- end row -->

                </div>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascript %}
{{ parent() }}
<script src="{{ asset('assets/admin/libs/datatables.net/js/jquery.dataTables.min.js') }}"></script>
<script src="{{ asset('assets/admin/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js') }}"></script>
<script src="{{ asset('assets/admin/libs/echarts/echarts.min.js') }}"></script>
<script src="{{ asset('assets/admin/libs/echarts/theme/roma.js') }}"></script>
{#<script src="{{ asset('assets/admin/libs/apexcharts/apexcharts.min.js') }}"></script>#}
<script src="{{ asset('assets/admin/js/pages/dashboard.init.js') }}"></script>


<script type="text/javascript">
    jQuery(document).ready(function ($) {

        var datatable = initDatatable();

         function initDatatable(){
            /* DATATABLE INIT */
            var dt = $('#datatable').DataTable( {
                'bLengthChange' : false,
                'responsive': true,
                'searching': false,
                'pageLength': 5,
                'language': {
                    url: '//cdn.datatables.net/plug-ins/1.10.16/i18n/French.json',
                   processing: "<img height='32' width='32' src='{{ asset("assets/images/preloaders/5.svg") }}' />",
                    sLoadingRecords :"<img height='32' width='32' src='{{ asset("assets/images/preloaders/5.svg") }} />",
                    info: "Affichage de _START_ à _END_ sur _TOTAL_ entrées",
                    infoEmpty: "Affichage de 0 à 0 sur 0 entrées",
                    lengthMenu: "Afficher _MENU_ entrées",
                    zeroRecords: "Aucune entrée correspondante trouvée",
                    paginate: {
                        first: '',
                        last: '',
                        next: '<i class="fa-solid fa-angle-right"></i>',
                        previous: '<i class="fa-solid fa-angle-left"></i>'
                    },
                    processing: '<i class="fa fa-spinner fa-spin fa-3x fa-fw text-warning"></i><span class="sr-only">Chargement en cours...</span>'
                },
                "processing": true,
                "serverSide": true,
                "ajax": {
                    "url": '{{ path('cnmci_souscription_datatable') }}',
                    "data": function (d) {
                    }
                },
                "columns": [
                    {"data":  "id"},
                    {"data":  "last_name"},
                    {"data":  "first_name"},
                    { "data": "subscription_date" },
                    { "data": "driving_license_number" },
                    { "data": "is_payment_validate" },
                    { "data": "status" },
                    { "data": "" }
                ],
                "select": {
                    style: 'multi+shift',
                    selector: 'td:first-child'
                },
                "order": [[1, 'desc']]
            } );
            return dt;
       }
    });
</script>
{% endblock %}
