{% extends 'admin/base.html.twig' %}

{% block stylesheet %}
    {{ parent() }}
    <link href="{{ asset('assets/admin/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css') }}" rel="stylesheet" type="text/css" />
    <link href="{{ asset('assets/admin/libs/datatables.net-bs4/css/select.dataTables.min.css') }}" rel="stylesheet" type="text/css" />
    <style>
        .btn-cnmci {
            background-color: #6e0000;
            color: #ffffff;
        }
        .btn-cnmci:hover {
            background-color: #6e0000;
            color: #ffffff;
        }
        .table>thead {
            background-color: #6e0000;
            color: #ffffff;
        }
        .active>.page-link, .page-link.active {
            background-color: #6e0000;
            border-color: #6e0000;
        }
    </style>
{% endblock %}

{% block body %}
        <div class="container-fluid">
            <div class="d-flex py-4">
                <a href="{{ path('cnmci_index')}}" class="btn btn-link waves-effect waves-light"><i class="fa fa-arrow-left"></i> Revenir à l'accueil</a>
            </div>
            <div class="d-flex justify-content-center">
                <img src="{{ asset('assets/frontend/img/cnmci.png') }}" alt="logo syncvtcci" width="150" alt="logo cnmci" style="border-collapse: collapse;border-width:0px 0px;" />
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                        <h4 class="mb-sm-0 font-size-18">Statistiques</h4>
                        <div class="page-title-right">
                            <ol class="breadcrumb m-0">
                            </ol>
                        </div>
                    </div>
                </div>
            </div><!-- end row -->
            <div class="row mb-4">
                <div class="col-lg-12">
                    <div class="d-flex align-items-center">
                        {% if app.user.photo %}
                            <img src="{{ asset('users/') ~ app.user.photo }}" alt="" class="avatar-sm rounded">
                        {% else %}
                            <img src="{{ asset('/assets/images/avatar/avatar.jpg') }}" alt="" class="avatar-sm rounded">
                        {% endif %}
                        <div class="ms-3 flex-grow-1">
                            <h5 class="mb-2 card-title">Bienvenue, {{ app.user.lastName|upper ~ ' ' ~ app.user.firstName}}</h5>
                        </div>
                    </div>
                </div><!--end col-->
            </div><!--end row-->
            <div class="row">
                <div class="col-lg-3">
                    <div class="card mini-stats-wid">
                        <div class="card-body">
                            <div class="d-flex">
                                <div class="flex-grow-1">
                                    <p class="text-muted fw-medium">Souscripteurs</p>
                                    <h4 class="mb-0">5 544</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!--end col-->
                <div class="col-lg-3">
                    <div class="card mini-stats-wid">
                        <div class="card-body">
                            <div class="d-flex">
                                <div class="flex-grow-1">
                                    <p class="text-muted fw-medium">Chauffeurs VTC</p>
                                    <h4 class="mb-0">14 895</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!--end col-->
                <div class="col-lg-3">
                    <div class="card mini-stats-wid">
                        <div class="card-body">
                            <div class="d-flex">
                                <div class="flex-grow-1">
                                    <p class="text-muted fw-medium">Chauffeurs TAXI</p>
                                    <h4 class="mb-0">14 574</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!--end col-->
                <div class="col-lg-3">
                    <div class="card mini-stats-wid">
                        <div class="card-body">
                            <div class="d-flex">
                                <div class="flex-grow-1">
                                    <p class="text-muted fw-medium">Chauffeurs LIVREURS</p>
                                    <h4 class="mb-0">10 000</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div><!--end col-->
            </div><!--end row-->
            <div class="row">
                <div class="col-lg-8">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-sm-flex flex-wrap">
                                <h4 class="card-title mb-4">Progression des souscriptions</h4>
                                <div class="ms-auto">
                                    <ul class="nav nav-pills">
                                        <li class="nav-item">
                                            <a class="nav-link" href="javascript:void(0);">Semaines</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" href="javascript:void(0);">Mois</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link active" href="javascript:void(0);">Années</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <div data-colors='["--bs-primary", "--bs-success", "--bs-warning", "--bs-info"]' dir="ltr" id="chart"></div>
                        </div>
                    </div>
                </div><!--end col-->
                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-body">
                            <h4 class="card-title mb-3">A l'instant</h4>
                            <div id="carouselExampleControls" class="carousel slide" data-bs-ride="carousel">
                                <div class="carousel-inner">

                                    <div class="carousel-item active" data-bs-interval="3000">
                                        {% for i, member in members|slice(0, 2) %}
                                        <div class="bg-light p-3 d-flex mb-3 rounded">
                                            <img src="/members/{{ member.reference }}/{{ member.photo }}" alt="" class="avatar-sm rounded me-3">
                                            <div class="flex-grow-1">
                                                <h5 class="font-size-15 mb-2"><a href="{{  path('admin_member_cncmi_show', {id: member.id}) }}" class="text-body">{{ member.lastName|upper ~ ' ' ~ member.firstName|upper }}</a> <span class="badge badge-soft-info">Freelance</span></h5>
                                                <p class="mb-0 text-muted"><i class="bx bx-map text-body align-middle"></i>{{ member.activity }}</p>
                                            </div>
                                            <div>
                                                <div class="dropdown">
                                                    <button class="btn btn-soft-primary" type="button" id="dropdownMenuButton11" data-bs-toggle="dropdown" aria-expanded="false">
                                                        <i class='bx bx-dots-vertical-rounded'></i>
                                                    </button>
                                                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton11">
                                                        <li><a class="dropdown-item" href="{{  path('admin_member_cncmi_show', {id: member.id}) }}">Voir detail</a></li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                        {% endfor %}
                                    </div>
                                    <div class="carousel-item" data-bs-interval="3000">
                                        {% for i, member in members|slice(2, 2) %}
                                            <div class="bg-light p-3 d-flex mb-3 rounded">
                                                <img src="/members/{{ member.reference }}/{{ member.photo }}" alt="" class="avatar-sm rounded me-3">
                                                <div class="flex-grow-1">
                                                    <h5 class="font-size-15 mb-2"><a href="{{  path('admin_member_cncmi_show', {id: member.id}) }}" class="text-body">{{ member.lastName|upper ~ ' ' ~ member.firstName|upper }}</a> <span class="badge badge-soft-info">Freelance</span></h5>
                                                    <p class="mb-0 text-muted"><i class="bx bx-map text-body align-middle"></i>{{ member.activity }}</p>
                                                </div>
                                                <div>
                                                    <div class="dropdown">
                                                        <button class="btn btn-soft-primary" type="button" id="dropdownMenuButton11" data-bs-toggle="dropdown" aria-expanded="false">
                                                            <i class='bx bx-dots-vertical-rounded'></i>
                                                        </button>
                                                        <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton11">
                                                            <li><a class="dropdown-item" href="{{  path('admin_member_cncmi_show', {id: member.id}) }}">Voir detail</a></li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                    <div class="carousel-item" data-bs-interval="3000">
                                        {% for i, member in members|slice(3, 2) %}
                                            <div class="bg-light p-3 d-flex mb-3 rounded">
                                                <img src="/members/{{ member.reference }}/{{ member.photo }}" alt="" class="avatar-sm rounded me-3">
                                                <div class="flex-grow-1">
                                                    <h5 class="font-size-15 mb-2"><a href="{{  path('admin_member_cncmi_show', {id: member.id}) }}" class="text-body">{{ member.lastName|upper ~ ' ' ~ member.firstName|upper }}</a> <span class="badge badge-soft-info">Freelance</span></h5>
                                                    <p class="mb-0 text-muted"><i class="bx bx-map text-body align-middle"></i>{{ member.activity }}</p>
                                                </div>
                                                <div>
                                                    <div class="dropdown">
                                                        <button class="btn btn-soft-primary" type="button" id="dropdownMenuButton11" data-bs-toggle="dropdown" aria-expanded="false">
                                                            <i class='bx bx-dots-vertical-rounded'></i>
                                                        </button>
                                                        <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton11">
                                                            <li><a class="dropdown-item" href="{{  path('admin_member_cncmi_show', {id: member.id}) }}">Voir detail</a></li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div><!--end card-->
                </div><!--end col-->
            </div><!--end row-->
            <div class="row">
                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex">
                                <h4 class="card-title">Progression des inscriptions</h4>
                                <div class="dropdown ms-auto">
                                    <a class="text-muted font-size-16" role="button" data-bs-toggle="dropdown" aria-haspopup="true">
                                        <i class="mdi mdi-dots-horizontal"></i>
                                    </a>

                                    <div class="dropdown-menu dropdown-menu-end">
                                        <a class="dropdown-item" href="#">Rafraichir</a>
                                    </div>
                                </div>
                            </div>

                            <div data-colors='["--bs-primary", "--bs-success", "--bs-warning", "--bs-info"]' dir="ltr" id="application-received-time"></div>
                        </div>
                    </div><!--end card-->
                </div><!--end col-->
                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-body">
                            <h4 class="card-title mb-4">Activités récentes</h4>
                            <div data-simplebar style="max-height: 376px;">
                                <ul class="verti-timeline list-unstyled">
                                    {% for i, member in members|slice(0, 5) %}
                                    <li class="event-list">
                                        <div class="event-timeline-dot">
                                            <i class="bx bx-right-arrow-circle font-size-18"></i>
                                        </div>
                                        <div class="d-flex">
                                            <div class="flex-shrink-0 me-3">
                                                <img src="/members/{{ member.reference }}/{{ member.photo }}" alt="" class="avatar-xs rounded-circle">
                                            </div>
                                            <div class="flex-grow-1">
                                                <div>
                                                    <b>{{ member.firstName|upper ~ ' ' ~ member.lastName|upper }}</b> vient de faire son inscription <b>{{ member.activity }}</b>
                                                    <p class="mb-0 text-muted">Il y' a 3 min</p>
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                    {% endfor %}
                                </ul>
                                <div class="text-center mt-4"><a href="javascript: void(0);" class="btn btn-primary waves-effect waves-light btn-sm">View More <i class="mdi mdi-arrow-right ms-1"></i></a></div>
                            </div>
                        </div>
                    </div><!--end card-->
                </div><!--end col-->
            </div><!--end row-->
        </div>
{% endblock %}

{% block javascript %}
{{ parent() }}
<script src="{{ asset('assets/admin/libs/datatables.net/js/jquery.dataTables.min.js') }}"></script>
<script src="{{ asset('assets/admin/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js') }}"></script>
<script src="{{ asset('assets/admin/libs/apexcharts/apexcharts.min.js') }}"></script>
<script src="{{ asset('assets/admin/js/pages/dashboard.init.js') }}"></script>

<script type="text/javascript">
    jQuery(document).ready(function ($) {


    });
</script>
{% endblock %}
