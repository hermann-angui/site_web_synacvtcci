{% extends 'admin/base.html.twig' %}

{% block stylesheet %}
    {{ parent() }}
    <style>
        .btn-cnmci {
            background-color: #6e0000;
            color: #ffffff;
        }
        .btn:hover {
            color: #fff;
            text-decoration: none;
            background-color: #343a40;
            border-color: var(--bs-btn-hover-border-color);
        }
        .table>thead {
            background-color: #6e0000;
            color: #ffffff;
        }
        .active>.page-link, .page-link.active {
            background-color: #6e0000;
            border-color: #6e0000;
        }
        .vertical-collpsed .main-content {
            margin-left: 10px !important;
        }
        .page-content {
            padding: 10px 0 0 0;
        }
    </style>
{% endblock %}

{% block body %}
        <div class="container-fluid mt-5">
            <div class="d-flex py-4">
                <a href="{{ path('admin_index')}}" class="btn btn-link waves-effect waves-light"><i class="fa fa-arrow-left"></i> Revenir à l'accueil</a>
            </div>
            <div class="d-flex justify-content-center mt-5">
                <img src="{{ asset('assets/frontend/img/cnmci.png') }}" alt="logo syncvtcci" width="150" alt="logo cnmci" style="border-collapse: collapse;border-width:0px 0px;" />
            </div>
            <div class="d-flex justify-content-center align-items-center align-content-center mt-5">
                <div class="col-md-4">
                    <div class="card card-body d-flex justify-content-center align-items-center p-4">
                        <h3 class="my-3">SUIVI DES SOUSCRIPTIONS</h3>
                        <div class="mb-3"><i class="fa fa-6x fa-database"></i></div>
                        <p class="card-text mb-3">Voir la liste détaillée des souscripteurs.</p>
                        <a href="{{ path('cnmci_souscripteurs') }}"  class="btn btn-cnmci w-100 waves-effect waves-light">Afficher</a>
                    </div>
                </div>
                <div class="col-md-4 m-4">
                    <div class="card card-body d-flex justify-content-center align-items-center p-4">
                        <h3 class="my-3">SUIVI DES STATISTIQUES</h3>
                        <div class="mb-3"><i class="fa fa-6x fa-chart-line"></i></div>
                        <p class="card-text mb-3">Voir les statistiques détaillées des souscriptions.</p>
                        <a href="{{ path('cnmci_stats')}}"  class="btn btn-cnmci w-100 waves-effect waves-light">Afficher</a>
                    </div>
                </div>
            </div>
        </div>
{% endblock %}

{% block javascript %}
{{ parent() }}
<script type="text/javascript">
    jQuery(document).ready(function ($) {
    });
</script>
{% endblock %}
