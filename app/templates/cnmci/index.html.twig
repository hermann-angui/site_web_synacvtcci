{% extends 'admin/base.html.twig' %}

{% block stylesheet %}
    {{ parent() }}
    <style>
        .btn-cnmci {
            background-color: #6e0000;
            color: #ffffff;
        }
        .btn:hover {
            color: #fff;
            text-decoration: none;
            background-color: #343a40;
            border-color: var(--bs-btn-hover-border-color);
        }
        .table>thead {
            background-color: #6e0000;
            color: #ffffff;
        }
        .active>.page-link, .page-link.active {
            background-color: #6e0000;
            border-color: #6e0000;
        }
        .vertical-collpsed .main-content {
            margin-left: 10px !important;
        }
    </style>
{% endblock %}

{% block body %}

    <div id="layout-wrapper">

        {% if is_granted('ROLE_ADMIN') %}
            {{ include('admin/_partials/header.html.twig') }}

            <!-- ========== Left Sidebar Start ========== -->
            {{ include('admin/_partials/left-sidebar.html.twig')}}
            <!-- Left Sidebar End -->
        {% endif %}

        {% if is_granted('ROLE_AGENT') %}
            {{ include('admin/_partials/simple-header.html.twig') }}
        {% endif %}
        <div class="page-content">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                            <h4 class="mb-sm-0 font-size-18">MENU CNMCI</h4>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-3">
                        <div class="card">
                            <div class="card-body p-4">
                                <div class="text-center mb-3">
                                    <div class="mb-3"><i class="fa fa-5x fa-database"></i></div>
                                    <a href="{{ path('cnmci_souscripteurs') }}" class="text-body">
                                        <h5 class="mt-4 mb-2 font-size-15">SUIVI DES SOUSCRIPTIONS</h5>
                                    </a>
                                    <p class="mb-0 text-muted">Voir la liste détaillée des souscripteurs.</p>
                                </div>
                                <div>
                                    <a href="{{ path('cnmci_souscripteurs') }}"  class="btn btn-cnmci w-100 waves-effect waves-light">Afficher</a>
                                </div>
                            </div>
                        </div><!--end card-->
                    </div><!--end col-->
                    <div class="col-lg-3">
                        <div class="card">
                            <div class="card-body p-4">
                                <div class="text-center mb-3">
                                    <div class="mb-3"><i class="fa fa-5x fa-chart-line"></i></div>
                                    <a href="{{ path('cnmci_stats')}}"  class="text-body">
                                        <h5 class="mt-4 mb-2 font-size-15">SUIVI DES STATISTIQUES</h5>
                                    </a>
                                    <p class="mb-0 text-muted">Voir les statistiques détaillées des souscriptions.</p>
                                </div>
                                <div>
                                    <a href="{{ path('cnmci_stats')}}"  class="btn btn-cnmci w-100 waves-effect waves-light">Afficher</a>
                                </div>
                            </div>
                        </div><!--end card-->
                    </div><!--end col-->
                    <div class="col-lg-3">
                        <div class="card">
                            <div class="card-body p-4">
                                <div class="text-center mb-3">
                                    <div class="mb-3"><i class="fa fa-5x fa-plus-square"></i></div>
                                    <a href="{{ path('cnmci_new_contravention')}}" class="text-body">
                                        <h5 class="mt-4 mb-2 font-size-15">ENREGISTRER UNE CONTRAVENTION</h5>
                                    </a>
                                    <p class="mb-0 text-muted">Enregistrer une nouvelle contravention.</p>
                                </div>
                                <div>
                                    <a href="{{ path('cnmci_new_contravention')}}"  class="btn btn-cnmci w-100 waves-effect waves-light">Afficher</a>
                                </div>
                            </div>
                        </div><!--end card-->
                    </div><!--end col-->
                    <div class="col-lg-3">
                        <div class="card">
                            <div class="card-body p-4">
                                <div class="text-center mb-3">
                                    <div class="mb-3"><i class="fa fa-5x fa-file"></i></div>
                                    <a href="{{ path('cnmci_list_contravention')}}" class="text-body">
                                        <h5 class="mt-4 mb-2 font-size-15">SUIVI DES CONTRAVENTIONS</h5>
                                    </a>
                                    <p class="mb-0 text-muted">Suivi et gérer les contraventions.</p>
                                </div>
                                <div>
                                    <a href="{{ path('cnmci_list_contravention')}}"  class="btn btn-cnmci w-100 waves-effect waves-light">Afficher</a>
                                </div>
                            </div>
                        </div><!--end card-->
                    </div><!--end col-->
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascript %}
{{ parent() }}
<script type="text/javascript">
    jQuery(document).ready(function ($) {
    });
</script>
{% endblock %}
