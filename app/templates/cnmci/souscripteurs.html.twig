{% extends 'admin/base.html.twig' %}

{% block stylesheet %}
    {{ parent() }}
    <link href="{{ asset('assets/admin/libs/sweetalert2/sweetalert2.min.css') }}" rel="stylesheet" type="text/css"/>
    <link href="{{ asset('assets/admin/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css') }}" rel="stylesheet"
          type="text/css"/>
    <link href="{{ asset('assets/admin/libs/datatables.net-bs4/css/select.dataTables.min.css') }}" rel="stylesheet"
          type="text/css"/>
    <style>
        .btn-cnmci {
            background-color: #6e0000;
            color: #ffffff;
        }

        .table > thead {
            background-color: #6e0000;
            color: #ffffff;
        }

        .active > .page-link, .page-link.active {
            background-color: #6e0000;
            border-color: #6e0000;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container-fluid mt-5">
        <div class="d-flex py-4">
            <a href="{{ path('cnmci_index')}}" class="btn btn-link waves-effect waves-light"><i class="fa fa-arrow-left"></i> Revenir à l'accueil</a>
        </div>
        <div class="d-flex justify-content-center">
            <img src="{{ asset('assets/frontend/img/cnmci.png') }}" alt="logo syncvtcci" width="150" alt="logo cnmci"
                 style="border-collapse: collapse;border-width:0px 0px;"/>
        </div>
        <!-- start page title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <h4 class="mb-sm-0 font-size-18">Liste des inscrits</h4>
                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                        </ol>
                    </div>
                </div>
            </div>
        </div>
        <!-- end page title -->
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body border-bottom">
                        <div class="row g-3">
                            <div class="col-auto">
                                <div class="mt-2 fw-bold float-end"> Du :</div>
                            </div>
                            <div class="col-xxl-2 col-lg-2">
                                <input type="date" class="form-control js-datepicker" id="date_start" name="date_start"
                                       value="{{ from }}">
                            </div>
                            <div class="col-auto">
                                <div class="mt-2 fw-bold float-end"> Au :</div>
                            </div>
                            <div class="col-xxl-2 col-lg-2">
                                <input type="date" class="form-control js-datepicker" id="date_end" name="date_end"
                                       value="{{ to }}">
                            </div>
                            <div class="col-xxl-1 col-lg-1">
                                <button class="btn btn-dark" id="search"><i class="fa fa-search"></i></button>
                            </div>
                            <div class="col-xxl-6 col-lg-5">
                                <div class="d-flex align-items-end">
                                    <h5 class="mb-0 card-title flex-grow-1"></h5>
                                    <div class="flex-shrink-0">
                                        <a id="btnMatrice" href="#" class="btn btn-cnmci"><span class="fa fa-file-download fa-1x"></span> Télécharger la matrice des encaissements</a>
                                        <a id="btnList" href="#" class="btn btn-cnmci"><span class="fa fa-download fa-1x"></span> Télécharger la liste des souscripteurs</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        {{ include('cnmci/_adherents_datatable.html.twig') }}
                    </div>
                </div><!--end card-->
            </div><!--end col-->
        </div><!--end row-->
    </div>
{% endblock %}

{% block javascript %}
{{ parent() }}
<script src="{{ asset('assets/admin/libs/sweetalert2/sweetalert2.min.js') }}"></script>
<script src="{{ asset('assets/frontend/js/vendor/jquery.datetimepicker.full.js') }}"></script>
<script src="{{ asset('assets/admin/libs/datatables.net/js/jquery.dataTables.min.js') }}"></script>
<script src="{{ asset('assets/admin/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js') }}"></script>

<script type="text/javascript">
    jQuery(document).ready(function ($) {
        var datatable = initDatatable();

        $("#search").click(function(){
            datatable.draw();
        });

        $('#btnMatrice').click(function(e){
            e.preventDefault();
            window.location.href = "{{ path('cnmci_download_matrice') }}?date_from=" +  $('#date_start').val() +  "&date_to=" + $('#date_end').val();
        });

        $('#btnList').click(function(e){
            e.preventDefault();
            window.location.href = "{{ path('cnmci_download_list') }}?date_from=" +  $('#date_start').val() +  "&date_to=" + $('#date_end').val();
        });

        $(document).on('click', '#btn-validate-souscription', function(e){
           e.preventDefault();
           var id =  $(this).data('id');
           Swal.fire({
            title: "Êtes vous sûr de valider?",
            text: "Assurez vous d'avoir fait les vérifications nécessaires!",
            icon: "warning",
            showCancelButton: !0,
            confirmButtonColor: "#34c38f",
            cancelButtonColor: "#f46a6a",
            confirmButtonText: "Oui",
            cancelButtonText: "Annuler"
          }).then(function(t) {
               $.get("/admin/cnmci/validate-souscription/" + id, function(data){
                   // console.log(data);
                   t.value && Swal.fire("Valider!", "Cette souscription a été validée.", "success")
                   datatable.draw();
               });
           });
        });

        // $('.js-datepicker').datetimepicker({
        //         timepicker: false,
        //         format:  'd/m/Y',
        //         scrollMonth : false,
	    //         scrollInput : false
        //         // mask: true, // '9999/19/39 29:59' - digit is the maximum possible for a cell
        // });

       function initDatatable(){
            /* DATATABLE INIT */
            var dt = $('#datatable').DataTable( {
                'bLengthChange' : false,
                'responsive': true,
                'searching': false,
                'pageLength': 5,
                'language': {
                    url: '//cdn.datatables.net/plug-ins/1.10.16/i18n/French.json',
                   // processing: "<img height='32' width='32' src='{{ asset("assets/images/preloaders/5.svg") }}' />",
                    sLoadingRecords :"<img height='32' width='32' src='{{ asset("assets/images/preloaders/5.svg") }} />",
                    info: "Affichage de _START_ à _END_ sur _TOTAL_ entrées",
                    infoEmpty: "Affichage de 0 à 0 sur 0 entrées",
                    lengthMenu: "Afficher _MENU_ entrées",
                    zeroRecords: "Aucune entrée correspondante trouvée",
                    paginate: {
                        first: '',
                        last: '',
                        next: '<i class="fa-solid fa-angle-right"></i>',
                        previous: '<i class="fa-solid fa-angle-left"></i>'
                    },
                    processing: '<i class="fa fa-spinner fa-spin fa-3x fa-fw text-warning"></i><span class="sr-only">Chargement en cours...</span>'
                },
                "processing": true,
                "serverSide": true,
                "ajax": {
                    "url": '{{ path('cnmci_souscription_datatable') }}',
                    "data": function (d) {
                        d.date_start = $("#date_start").val();
                        d.date_end = $("#date_end").val();
                    }
                },
                "columns": [
                    {"data":  "id"},
                    {"data":  "last_name"},
                    {"data":  "first_name"},
                    { "data": "subscription_date" },
                    { "data": "driving_license_number" },
                    { "data": "is_payment_validate" },
                    { "data": "status" },
                    { "data": "" }
                ],
                "order": [[1, 'desc']]
            } );
            return dt;
       }
    });
</script>
{% endblock %}
