{% extends 'admin/base.html.twig' %}

{% block stylesheet %}
    {{ parent() }}
    <link href="{{ asset('assets/admin/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css') }}" rel="stylesheet" type="text/css" />
    <link href="{{ asset('assets/admin/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css') }}" rel="stylesheet" type="text/css" />
    <link href="{{ asset('assets/admin/libs/sweetalert2/sweetalert2.min.css') }}" rel="stylesheet" type="text/css" />
{#    <link href="{{ asset('assets/admin/libs/datatables.net-bs4/css/select.bootstrap4.css') }}" rel="stylesheet" type="text/css"/>#}
{#    <link href="{{ asset('assets/admin/libs/datatables.net-bs4/css/select.dataTables.min.css') }}" rel="stylesheet" type="text/css"/>#}

{% endblock %}

{% block body %}
    <div class="layout-wrapper">
        <div class="main-content">
            <div class="page-content">
                <div class="container-fluid">
                    <div class="d-flex justify-content-center">
                        <img src="{{ asset('assets/frontend/img/cnmci.png') }}" alt="logo syncvtcci" width="120" alt="logo cnmci" style="border-collapse: collapse;border-width:0px 0px;" />
                    </div>
                    <div class="d-flex justify-content-between py-4">
                        <div class="col-lg-9"><a href="{{ path('cnmci_index')}}" class="btn btn-link waves-effect waves-light"><i class="fa fa-arrow-left"></i> Revenir à l'accueil</a></div>
                        <div class="col-lg-3 justify-content-end ">
                            <div class="d-flex align-items-center">
                                {% if app.user.photo %}
                                    <img src="{{ asset('users/') ~ app.user.photo }}" alt="" class="avatar-sm rounded">
                                {% else %}
                                    <img src="{{ asset('/assets/images/avatar/avatar.jpg') }}" alt="" class="avatar-sm rounded">
                                {% endif %}
                                <div class="ms-3 flex-grow-1">
                                    <h5 class="mb-2 card-title">Bienvenue, {{ app.user.lastName|upper ~ ' ' ~ app.user.firstName}}</h5>
                                </div>
                            </div>
                        </div><!--end col-->
                    </div>
                    <!-- start page title -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                                <h4 class="mb-sm-0 font-size-18">Liste des souscripteurs</h4>
                                <div class="page-title-right">
                                    <ol class="breadcrumb m-0">
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- end page title -->
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="card">
                                <div class="card-body border-bottom">
                                    <div class="row g-3">
                                        <div class="col-auto">
                                            <div class="mt-2 fw-bold float-end"> Du :</div>
                                        </div>
                                        <div class="col-xxl-2 col-lg-2">
                                            <input type="date" class="form-control js-datepicker" id="date_start" name="date_start"
                                                   value="{{ from }}">
                                        </div>
                                        <div class="col-auto">
                                            <div class="mt-2 fw-bold float-end"> Au :</div>
                                        </div>
                                        <div class="col-xxl-2 col-lg-2">
                                            <input type="date" class="form-control js-datepicker" id="date_end" name="date_end"
                                                   value="{{ to }}">
                                        </div>
                                        <div class="col-xxl-1 col-lg-1">
                                            <button class="btn btn-dark" id="btn-filter"><i class="fa fa-search"></i></button>
                                        </div>
                                        <div class="col-xxl-6 col-lg-5">
                                            <div class="d-flex align-items-end">
                                                <h5 class="mb-0 card-title flex-grow-1"></h5>
                                                <div class="flex-shrink-0">
                                                    <div class="btn-group" id="validation-btn-group">
                                                        <button type="button" class="btn btn-soft-success"><i class="mdi mdi-check-all"></i> Valider (<span id="selected"></span>)</button>
                                                        <button type="button" class="btn btn-soft-success dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                                                            <i class="mdi mdi-chevron-down"></i>
                                                        </button>
                                                        <div class="dropdown-menu" style="">
                                                            <a id="btn-validate-payments-batch" class="dropdown-item p-2" href="#"><span class="fa fa-money-check fa-1x"></span> Tous les paiements</a>
                                                            <a id="btn-validate-souscriptions-batch" class="dropdown-item p-2" href="#"><span class="fa fa-file fa-1x"></span> Toutes les souscriptions</a>
                                                        </div>
                                                    </div>
                                                    <div class="btn-group">
                                                        <button type="button" class="btn btn-soft-success"><i class="mdi mdi-download"></i> Télécharger</button>
                                                        <button type="button" class="btn btn-soft-success dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                                                            <i class="mdi mdi-chevron-down"></i>
                                                        </button>
                                                        <div class="dropdown-menu" style="">
                                                            <a id="btnMatrice" class="dropdown-item p-2" href="#"><span class="fa fa-file-download fa-1x"></span> La matrice des encaissements</a>
                                                            <a id="btnList" class="dropdown-item p-2" href="#"><span class="fa fa-download fa-1x"></span> La liste des souscripteurs</a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    {{ include('cnmci/_adherents_datatable.html.twig') }}
                                </div>
                            </div><!--end card-->
                        </div><!--end col-->
                    </div><!--end row-->
                </div>
            </div>
        </div>
    </div>

    <!-- subscribeModal -->
    <div class="modal fade" id="valider-inscription-modal" tabindex="-1" aria-labelledby="subscribeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-bottom-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="avatar-md mx-auto mb-4">
                        <div class="avatar-title bg-light rounded-circle text-primary h1">
                            <i class="mdi mdi-check-circle"></i>
                        </div>
                    </div>
                    <div class="row mb-3 p-3">
                        <div class="alert alert-warning">
                            <p><i class="mdi mdi-alert-circle mdi-24px"></i>  Vous vous apprêtez à valider l'inscription de cet artisan.<br> Assurez vous que toutes les vérifications necessaire ont été faites.</p>
                        </div>
                        <form id="validationFrm" name="validationFrm" method="post" action="{{ path('cnmci_validation_souscription') }}">
                            <div class="mb-3">
                                <label for="cnmci_numero_rm" class="form-label">N° RM</label>
                                <input type="text" class="form-control" name="cnmci_numero_rm" placeholder="Numéro RM ">
                            </div>
                            <div class="mb-3">
                                <label for="cnmci_carte_professionelle" class="form-label">N° Carte professionnelle</label>
                                <input type="text" class="form-control" name="cnmci_carte_professionelle" placeholder="Numéro carte proffessionnelle">
                            </div>
                            <input type="hidden" class="form-control" value="" name="member_id" hidden="hidden" aria-hidden="true">
                            <hr>
                            <div class="row justify-content-end">
                                <div class="col-sm-9">
                                    <div>
                                        <button type="button" class="btn btn-info me-1" data-dismiss="modal" id="modal-btn-close"> Annuler</button>
                                        <button type="submit" class="btn btn-dark me-1" data-dismiss="modal"> Enregister</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- end modal -->

{% endblock %}

{% block javascript %}
{{ parent() }}
<script src="{{ asset('assets/admin/libs/datatables.net/js/jquery.dataTables.min.js') }}"></script>
<script src="{{ asset('assets/admin/libs/sweetalert2/sweetalert2.min.js') }}"></script>
<script src="{{ asset('assets/frontend/js/vendor/jquery.datetimepicker.full.js') }}"></script>
<script src="{{ asset('assets/admin/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js') }}"></script>
<script src="{{ asset('assets/admin/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js') }}"></script>
<script src="{{ asset('assets/admin/libs/datatables.net-responsive-bs4/js/dataTables.responsive.min.js') }}"></script>
{#<script src="{{ asset('assets/admin/libs/datatables.net-bs4/js/dataTables.fixedColumns.js') }}"></script>#}
{#<script src="{{ asset('assets/admin/libs/datatables.net-bs4/js/dataTables.js') }}"></script>#}
{#<script src="{{ asset('assets/admin/libs/datatables.net-bs4/js/dataTables.select.js') }}"></script>#}
{#<script src="{{ asset('assets/admin/libs/datatables.net-bs4/js/fixedColumns.bootstrap4.js') }}"></script>#}
{#<script src="{{ asset('assets/admin/libs/datatables.net-bs4/js/popper.min.js') }}"></script>#}
{#<script src="{{ asset('assets/admin/libs/datatables.net-bs4/js/select.bootstrap4.js') }}"></script>#}

<script type="text/javascript">
    jQuery(document).ready(function ($) {

        $('#validation-btn-group').hide();
        var selectedRow = [];

        var datatable = initDatatable();

        $("#btn-filter").click(function(){
            datatable.draw();
        });

        $('#btnMatrice').click(function(e){
            e.preventDefault();
            window.location.href = "{{ path('cnmci_download_matrice') }}?date_from=" +  $('#date_start').val() +  "&date_to=" + $('#date_end').val();
        });

        $('#btn-validate-souscriptions-batch').click(function(){
            $.post('/cnmci/validate/souscription-cnmci/batch', {ids: selectedRow}, function(d){
                datatable.draw();
            });
        });

        $('#btn-validate-payments-batch').click(function(){
            $.post('/cnmci/validate/paiement-souscription/batch', {ids: selectedRow}, function(d){
                datatable.draw();
            });
        });

        $('#btnList').click(function(e){
            e.preventDefault();
            window.location.href = "{{ path('cnmci_download_list') }}?date_from=" +  $('#date_start').val() +  "&date_to=" + $('#date_end').val();
        });

        $(document).on('click', '#row-selector-all', function(){
            $('input.row-selector:checkbox').not(this).prop('checked', this.checked);
            selectedRow = [];
            $('input.row-selector:checkbox').each(function (item) {
                if($(this).is(":checked")){
                    $(this).parents().closest('tr').css('background-color', "#fffef3");
                    selectedRow.push($(this).data('id'));
                }else{
                    $(this).parents().closest('tr').css('background-color', "transparent");
                }
            });
            if(selectedRow.length > 1 ) {
                $('#validation-btn-group').show();
                $('#selected').text(selectedRow.length + ' selectionnés')
            }
            else $('#validation-btn-group').hide();
        });

        $(document).on('change', '.row-selector', function(e){
            var id = $(this).data('id');
            if($(this).is(":checked")){
                $(this).parents().closest('tr').css('background-color', "#f8f7e3");
                selectedRow.push(id);
            }else{
                $(this).parents().closest('tr').css('background-color', "transparent");
                selectedRow = selectedRow.filter(function(item) {
                    return item !== id
                });
            }
            if(selectedRow.length > 1 ) {
                $('#validation-btn-group').show();
                $('#selected').text(selectedRow.length + ' selectionnés')
            }
            else $('#validation-btn-group').hide();
        });

        $(document).on('click', '.btn-validate-payment', function(e){
           e.preventDefault();
           var id =  $(this).data('id');
           Swal.fire({
            title: "Êtes vous sûr de valider?",
            text: "Assurez vous d'avoir fait les vérifications nécessaires!",
            icon: "warning",
            showCancelButton: !0,
            confirmButtonColor: "#34c38f",
            cancelButtonColor: "#f46a6a",
            confirmButtonText: "Oui",
            cancelButtonText: "Annuler"
          }).then(function(t) {
               $.get("/cnmci/validate/paiement-souscription/" + id, function(data){
                    Swal.fire({
                        position: "center",
                        icon: "success",
                        title: "Enregistrement effectuée avec succès",
                        showConfirmButton: false,
                        timer: 1500
                    }).then(function (result) {
                        datatable.draw();
                        datatable.addClass("form-select form-select-sm");
                        datatable.addClass("pagination-rounded");
                    });
               });
           });
        });

        $(document).on('click', '.btn-validate-souscription', function(e){
             $("input[name='member_id']").val($(this).data('id'));
             $('#valider-inscription-modal').modal('show');
        });

        $(document).on("click", "#modal-btn-close", function(){
            var form1 = $("form[name='validationFrm']");
            form1[0].reset();
            $('#valider-inscription-modal').modal('hide');
        });

       $(document).on("submit", "form[name='validationFrm']", function(event) {
                event.preventDefault();
                var form = $("form[name='validationFrm']");
                var formData = new FormData(form[0]);
                $.ajax({
                    type: form.attr('method'),
                    url: form.attr('action'),
                    data: formData,
                    cache: false,
                    contentType: false,
                    processData: false
                })
                .done(function(data) {
                    if(data=== 'SUCCESS'){
                         Swal.fire({
                            position: "center",
                            icon: "success",
                            title: "Enregistrement effectuée avec succès",
                            showConfirmButton: false,
                            timer: 1500
                        }).then(function (result) {
                            form[0].reset();
                            $('#valider-inscription-modal').modal('hide');
                            datatable.draw();
                        });
                    }else{
                        Swal.fire({
                            position: "center",
                            icon: "error",
                            title: "Enregistrement a échoué",
                            showConfirmButton: false,
                            timer: 1500
                        }).then(function (result) {
                            form[0].reset();
                            $('#valider-inscription-modal').modal('hide');
                        });
                    }

                })
                .fail(function(data) {
                    Swal.fire({
                        position: "center",
                        icon: "error",
                        title: "Enregistrement a échoué",
                        showConfirmButton: false,
                        timer: 1500
                    }).then(function (result) {
                        form[0].reset();
                        $('#valider-inscription-modal').modal('hide');
                    });
                });
       });

       function initDatatable(){
            /* DATATABLE INIT */
            var dt = $('#datatable').DataTable( {
                bLengthChange : true,
                responsive: true,
                searching: false,
                pageLength: 15,
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.10.16/i18n/French.json',
                    info: "Affichage de _START_ à _END_ sur _TOTAL_ entrées",
                    infoEmpty: "Affichage de 0 à 0 sur 0 entrées",
                    lengthMenu: "Afficher _MENU_ entrées",
                    zeroRecords: "Aucune entrée correspondante trouvée",
                    oPaginate: {
                        sNext: '<i class="mdi mdi-chevron-right"></i>',
                        sPrevious: '<i class="mdi mdi-chevron-left"></i>'
                    },
                   // processing: '<i class="fa fa-spinner fa-spin fa-3x fa-fw text-warning"></i><span class="sr-only">Chargement en cours...</span>'
                },
                processing: true,
                serverSide: true,
                ajax: {
                    "url": '{{ path('cnmci_souscription_datatable') }}',
                    "data": function (d) {
                        d.date_start = $("#date_start").val();
                        d.date_end = $("#date_end").val();
                    }
                },
                columns: [
                    {"data":  "id" , "sortable": false},
                    {"data":  "photo" },
                    {"data":  "last_name" },
                    {"data":  "first_name" },
                    { "data": "subscription_date" },
                    { "data": "driving_license_number" },
                    { "data": "is_payment_validated" },
                    { "data": "is_inscription_validated" },
                    { "data": "reference" }
                ],
                order: [[1, 'desc']],
                drawCallback: function () {
                   $(".dataTables_paginate").addClass("pagination-rounded");
                }
            });

            return dt;
       }

    });
</script>
{% endblock %}
